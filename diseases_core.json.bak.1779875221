    ],
    "source_verified_medical_summary": {
      "definition_and_core_problem": "感音神经性听力损失是神经相关诊断条目。M1阶段用于识别其核心临床问题、典型症状组合、查体线索、实验室/影像证据、危险信号和鉴别诊断；不能仅凭患者自述病名、单一症状或旧诊断标签直接采纳，需要结合权威来源中的诊断框架与当前证据。本地RAG检索应覆盖：症状模式、体征模式、关键检查、相似疾病排除、严重程度和需要转诊/急诊的红旗信号。原始简述：感音神经性听力损失：以头痛、眩晕、抽搐、认知、运动、感觉或神经定位体征异常为主要表现的神经系统疾病。诊断需结合神经查体和必要影像/电生理。 质量闸门补充：感音神经性听力损失在本库中必须作为神经候选诊断进行证据链核对，重点关联症状、体征、实验室/影像异常、危险因素和排除诊断。",
      "key_symptom_pattern": "鼻咽喉耳局部症状明确；查体或内镜提示上气道/耳部病变；症状与感染、过敏或结构异常相符；主要系统症状；病程变化；疼痛或不适；功能受限；全身症状；复发或进展；红旗表现",
      "key_exam_findings": "神经定位体征；肌力异常；感觉异常；反射异常；生命体征；受累系统查体；严重程度评估；并发症体征；红旗体征筛查；专科查体按需",
      "key_tests_or_imaging": "血糖；电解质；感染指标；脑脊液检查；血常规；肝肾功能；炎症指标；病因相关专项检查；危急值筛查按需；头颅CT；头颅MRI；脑电图；神经电生理；受累系统影像；超声/CT/MRI按病种；内镜或功能检查按需",
      "differential_focus": "脑卒中；癫痫；偏头痛；颅内感染；代谢性脑病；感染性疾病；炎症或自身免疫病；肿瘤性疾病；代谢或药物因素；功能性疾病",
      "pathophysiology_focus": "感音神经性听力损失的病理生理按神经框架理解：神经系统疾病可由缺血/出血、感染炎症、退行性变、脑脊液循环异常、周围神经损伤或神经发育异常导致；诊断重点是定位、起病速度、客观神经体征和影像/电生理证据。 本地诊断排序时，应把病程急缓、受累部位、危险因素、客观检查结果和鉴别诊断同时纳入病理轴评分；若出现生命体征不稳、进行性神经功能缺损、气道/循环障碍、严重出血、疑似恶性肿瘤或母胎风险，应标记为需要外部检查/专科评估。原始病理轴提示：感音神经性听力损失 主要涉及 upper_airway_involvement, mucosal_barrier_dysfunction, secretion_or_retention 等病理轴；M1仅用于诊断匹配，不直接生成治疗方案。 质量闸门补充：若临床表现与该病理轴不一致，应降低候选权重，并优先考虑同系统急危重症、感染、肿瘤、代谢或药物因素。",
      "red_flags_or_complications": "病情进展或复发；器官功能损害；误诊或延误诊断；需急诊/专科评估的红旗情况",
      "local_retrieval_keywords": [
