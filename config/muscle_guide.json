        },
        {
          "name": "髂腰肌",
          "role": "髋屈曲主动肌，久坐变短引起骨盆前倾和腰前侧痛",
          "symptom_keywords": [
            "腹股沟痛",
            "弯腰困难",
            "骨盆前倾"
          ],
          "image_hint": "iliopsoas",
          "priority": 5
        },
        {
          "name": "股方肌",
          "role": "髋外旋深层小肌，痉挛引发臀深部局限痛",
          "symptom_keywords": [
            "臀底痛",
            "坐骨内侧",
            "深部臀痛"
          ],
          "image_hint": "piriformis",
          "priority": 6
        }
      ],
      "secondary_keywords": {
        "坐骨": {
          "muscles": [
            "梨状肌",
